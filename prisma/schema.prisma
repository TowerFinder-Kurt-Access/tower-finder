generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("POSTGRES_URL")
  directUrl  = env("POSTGRES_URL")
}

model Tower {
  id                  Int               @id @default(autoincrement())
  lat                 Float
  lon                 Float
  typeId              Int?
  carrierId           Int?
  licenseeId          Int?
  businessName        String?
  remarks             String?
  titleHolder         String?
  expiration          String?
  legacyStatus        String?           @map("status")
  googleMapsUrl       String?
  streetViewUrl       String?
  source              String            @default("Excel Import")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  statusId            Int?
  avgBusinessDistance Float?
  businessCount       Int?
  placesProcessedAt   DateTime?
  parcelProcessedAt   DateTime?
  rawImportData       Json?             @map("rawExcelData")
  businessesNearby    BusinessNearby[]
  notes               Note[]
  parcel              Parcel?
  phones              Phone[]
  carrier             Carrier?          @relation(fields: [carrierId], references: [id])
  Licensee            Licensee?         @relation(fields: [licenseeId], references: [id])
  status              TowerStatus?      @relation(fields: [statusId], references: [id])
  type                TowerType?        @relation(fields: [typeId], references: [id])
  assignments         TowerAssignment[]
  leadSource          TowerLead?
  cellMapperLog       CellMapperLog?

  @@unique([lat, lon])
}

model Phone {
  id        Int          @id @default(autoincrement())
  number    String
  status    String       @default("unknown")
  towerId   Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tower     Tower        @relation(fields: [towerId], references: [id], onDelete: Cascade)
  checks    PhoneCheck[]

  @@index([towerId])
  @@index([number])
}

model PhoneCheck {
  id        Int      @id @default(autoincrement())
  phoneId   Int
  apiName   String
  status    String
  rawResult Json
  checkedAt DateTime @default(now())
  phone     Phone    @relation(fields: [phoneId], references: [id], onDelete: Cascade)

  @@index([phoneId])
  @@index([apiName])
}

model BusinessNearby {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  distance  Float
  rawData   Json?
  towerId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tower     Tower    @relation(fields: [towerId], references: [id], onDelete: Cascade)

  @@index([towerId])
}

model Parcel {
  id               Int       @id @default(autoincrement())
  parcelId         String?
  address          String?
  streetNumber     String?
  streetName       String?
  streetType       String?
  streetDir        String?
  unit             String?
  postalCode       String?
  cityRaw          String?
  countyRaw        String?   @map("county")
  stateRaw         String?
  provinceRaw      String?
  zip              String?
  country          String?
  rawData          Json?
  dataSource       String?
  geometry         Json?
  towerId          Int       @unique
  ownerId          Int?
  cityId           Int?
  provinceId       Int?
  countyId         Int?
  city             City?     @relation(fields: [cityId], references: [id])
  countyNormalized County?   @relation(fields: [countyId], references: [id])
  owner            Owner?    @relation(fields: [ownerId], references: [id])
  province         Province? @relation(fields: [provinceId], references: [id])
  tower            Tower     @relation(fields: [towerId], references: [id])
}

model Owner {
  id        Int       @id @default(autoincrement())
  name      String
  type      String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contacts  Contact[]
  parcels   Parcel[]
}

model Contact {
  id      Int     @id @default(autoincrement())
  type    String
  value   String
  label   String?
  isValid Boolean @default(true)
  ownerId Int
  owner   Owner   @relation(fields: [ownerId], references: [id])
}

model User {
  id               Int               @id @default(autoincrement())
  email            String            @unique
  name             String
  password         String
  role             Role              @default(CALLER)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lastLogin        DateTime?
  notes            Note[]
  towerAssignments TowerAssignment[]

  @@index([email])
  @@index([role])
}

model TowerAssignment {
  id         Int      @id @default(autoincrement())
  userId     Int
  towerId    Int
  assignedAt DateTime @default(now())
  assignedBy Int?
  tower      Tower    @relation(fields: [towerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, towerId])
  @@index([userId])
  @@index([towerId])
}

model Note {
  id        Int           @id @default(autoincrement())
  content   String
  authorId  Int?
  towerId   Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  initials  String?
  author    User?         @relation(fields: [authorId], references: [id])
  tower     Tower         @relation(fields: [towerId], references: [id], onDelete: Cascade)
  history   NoteHistory[]

  @@index([authorId])
}

model NoteHistory {
  id        Int      @id @default(autoincrement())
  noteId    Int
  content   String
  initials  String?
  updatedAt DateTime @default(now())
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

model TowerType {
  id     Int     @id @default(autoincrement())
  name   String
  towers Tower[]
}

model TowerStatus {
  id     Int     @id @default(autoincrement())
  name   String
  towers Tower[]
}

model Carrier {
  id       Int        @id @default(autoincrement())
  name     String
  Licensee Licensee[]
  towers   Tower[]
}

model Province {
  id       Int      @id @default(autoincrement())
  code     String   @unique
  name     String
  cities   City[]
  counties County[]
  parcels  Parcel[]
}

model City {
  id         Int      @id @default(autoincrement())
  name       String
  provinceId Int
  province   Province @relation(fields: [provinceId], references: [id])
  parcels    Parcel[]

  @@unique([name, provinceId])
}

model County {
  id         Int      @id @default(autoincrement())
  name       String
  provinceId Int
  province   Province @relation(fields: [provinceId], references: [id])
  parcels    Parcel[]

  @@unique([name, provinceId])
}

model TowerLead {
  id                Int       @id @default(autoincrement())
  lat               Float
  lon               Float
  source            String
  sourceId          String?
  type              String?
  tags              Json?
  province          String?
  promotedToTowerId Int?      @unique
  promotedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  city              String?
  country           String?
  promotedToTower   Tower?    @relation(fields: [promotedToTowerId], references: [id])

  @@unique([lat, lon, source])
  @@index([country, city])
  @@index([province])
  @@index([source])
}

model LeadSearch {
  id          Int      @id @default(autoincrement())
  country     String
  city        String?
  source      String   @default("OpenStreetMap")
  status      String   @default("pending")
  resultCount Int?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  province    String?

  @@unique([country, province, city, source])
}

model JobQueue {
  id          Int       @id @default(autoincrement())
  jobType     String
  status      String    @default("pending")
  params      Json
  result      Json?
  error       String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([jobType])
}

model CellMapperLog {
  id              Int       @id @default(autoincrement())
  towerId         Int       @unique
  h3Index         String
  matchScore      String    // "High", "Medium", "Potential"
  structureType   String
  isVerified      Boolean
  height          Float?
  lastVerifiedAt  DateTime
  rawData         Json      // Combined raw data of the match
  tower           Tower     @relation(fields: [towerId], references: [id], onDelete: Cascade)

  @@index([h3Index])
  @@index([matchScore])
}

model Licensee {
  id        Int      @id @default(autoincrement())
  name      String
  carrierId Int?
  Carrier   Carrier? @relation(fields: [carrierId], references: [id])
  Tower     Tower[]
}

enum Role {
  ADMIN
  CALLER
}
