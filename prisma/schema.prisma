generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("POSTGRES_URL")
}

model Tower {
  id        Int      @id @default(autoincrement())
  lat       Float
  lon       Float
  typeId    Int?
  type      TowerType? @relation(fields: [typeId], references: [id])
  carrierId Int?
  carrier   Carrier? @relation(fields: [carrierId], references: [id]) // Denormalized for convenience
  licenseeId Int?
  licensee   Licensee? @relation(fields: [licenseeId], references: [id])
  
  businessName String?
  remarks      String?
  titleHolder  String?
  expiration   String?
  status    String   @default("Unknown") // Workflow status

  googleMapsUrl String?
  streetViewUrl String? // Custom street view URL once properly located
  source    String   @default("Excel Import") // "Excel Import" or "Tower Finder"

  // A tower sits on a specific parcel of land
  parcel    Parcel?

  // Notes for tracking progress and communications
  notes     Note[]

  // User assignments (many-to-many)
  assignments TowerAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reverse relation from TowerLead when promoted
  leadSource TowerLead?

  // Coordinate uniqueness to ensure we don't duplicate towers
  @@unique([lat, lon])
}

model Parcel {
  id          Int      @id @default(autoincrement())
  parcelId    String?  // The official county/city parcel ID
  address     String?  // Original full address string
  
  // Decomposed Address Fields (ODA compatible)
  streetNumber String?
  streetName   String?
  streetType   String?
  streetDir    String?
  unit         String?
  postalCode   String?
  
  cityRaw     String?  // Raw city name
  county      String?  // County/Region
  stateRaw    String?  // Raw State/Province
  provinceRaw String?  // Raw Province (Canadian)
  zip         String?  // Legacy or duplication for easy access reference
  country     String?  // Country code (US, CA, etc.)
  rawData     Json?    // Store raw API response for debugging
  dataSource  String?  // Track which API provided this data (e.g., "ReportAll", "Regrid", etc.)
  geometry    Json?    // Store parcel boundary geometry (GeoJSON)

  // Relation to Tower (One Parcel can have a tower)
  towerId     Int      @unique
  tower       Tower    @relation(fields: [towerId], references: [id])

  // Relation to Owner
  ownerId     Int?
  owner       Owner?   @relation(fields: [ownerId], references: [id])

  // Normalized Location Relations
  cityId      Int?
  city        City?       @relation(fields: [cityId], references: [id])
  provinceId  Int?
  province    Province?   @relation(fields: [provinceId], references: [id])
}

model Owner {
  id        Int      @id @default(autoincrement())
  name      String
  type      String?  // "Individual", "LLC", "Trust", "Corp"
  address   String?  // Mailing address of the owner (often different from parcel address)
  
  parcels   Parcel[]
  contacts  Contact[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id        Int      @id @default(autoincrement())
  type      String   // "Phone", "Email"
  value     String
  label     String?  // "Mobile", "Office", "Home", "Attorney"
  isValid   Boolean  @default(true) // For marking bad numbers/emails

  ownerId   Int
  owner     Owner    @relation(fields: [ownerId], references: [id])
}

enum Role {
  ADMIN
  CALLER
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String   // Hashed with bcrypt
  role      Role     @default(CALLER)
  isActive  Boolean  @default(true)

  // Tower assignments (many-to-many)
  towerAssignments TowerAssignment[]

  // Notes authored by this user
  notes     Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?

  @@index([email])
  @@index([role])
}

model TowerAssignment {
  id        Int      @id @default(autoincrement())

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  towerId   Int
  tower     Tower    @relation(fields: [towerId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())
  assignedBy Int?     // Admin who made the assignment

  @@unique([userId, towerId])
  @@index([userId])
  @@index([towerId])
}

model Note {
  id        Int      @id @default(autoincrement())
  content   String

  // Migrated from string to User relation
  authorId  Int?     // Nullable for backward compatibility with old notes
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  towerId   Int
  tower     Tower    @relation(fields: [towerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}



model TowerType {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  towers Tower[]
}

model Carrier {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  licensees Licensee[]
  towers    Tower[]
}

model Licensee {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  carrierId Int?
  carrier   Carrier? @relation(fields: [carrierId], references: [id])
  towers    Tower[]
}

model Province {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String   @unique
  cities    City[]
  parcels   Parcel[]
}

model City {
  id         Int      @id @default(autoincrement())
  name       String
  provinceId Int
  province   Province @relation(fields: [provinceId], references: [id])
  parcels    Parcel[]

  @@unique([name, provinceId])
}


model TowerLead {
  id        Int      @id @default(autoincrement())
  lat       Float
  lon       Float
  source    String   // e.g. "OpenStreetMap", "Google Maps", "Manual"
  sourceId  String?  // External ID from the source (e.g. OSM node ID)
  type      String?  // e.g. "tower", "mast"
  tags      Json?    // Raw metadata from the source
  province  String?  // Province/state for quick filtering

  // When promoted to a Tower, link to it
  promotedToTowerId Int?      @unique
  promotedToTower   Tower?    @relation(fields: [promotedToTowerId], references: [id])
  promotedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lat, lon, source])
  @@index([province])
  @@index([source])
}
