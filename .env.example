# Database
PRISMA_DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
POSTGRES_URL="postgresql://user:password@localhost:5432/dbname"

# Authentication
NEXTAUTH_SECRET="your-nextauth-secret"
MASTER_PASSWORD="admin-setup-password"

# External APIs
REPORTALL_API_KEY="your-reportall-key"
WHITEPAGES_API_KEY="your-whitepages-key"
GEOAPIFY_API_KEY="your-geoapify-key"
NUMVERIFY_API_KEY="your-numverify-key"

# Feature Flags
ENABLE_PARCEL_CACHE="false"

# Cron / Automation
CRON_SECRET="your-cron-secret"

# Resend — transactional emails (OTP sign-in codes)
# Free tier: 3,000/mo, 100/day
RESEND_API_KEY="your-resend-api-key"
# From address — must use a verified Resend domain (slvtechnical.com verified)
EMAIL_FROM="Tower Finder <no-reply@eurovape.com>"
# Dashboard template id or alias (leave empty to use inline HTML fallback)
RESEND_TEMPLATE_ID=
