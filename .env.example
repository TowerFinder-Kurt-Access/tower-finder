# Database
PRISMA_DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
POSTGRES_URL="postgresql://user:password@localhost:5432/dbname"

# Optional. Nothing in the current code reads this; kept for tooling that
# expects the generic name.
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# Optional. Connections per serverless instance. The database role caps at 45,
# so keep instances × this under that. Default is 5 (about 9 instances).
PRISMA_POOL_LIMIT="5"

# Authentication
NEXTAUTH_SECRET="your-nextauth-secret"
MASTER_PASSWORD="admin-setup-password"

# External APIs
REPORTALL_API_KEY="your-reportall-key"
WHITEPAGES_API_KEY="your-whitepages-key"
GEOAPIFY_API_KEY="your-geoapify-key"
NUMVERIFY_API_KEY="your-numverify-key"

# Optional. Cell-data lookups; no code path currently requests it.
OPENCELLID_API_KEY="your-opencellid-key"

# Feature Flags
ENABLE_PARCEL_CACHE="false"

# Cron / Automation
CRON_SECRET="your-cron-secret"

# Resend — transactional emails (OTP sign-in codes)
# Free tier: 3,000/mo, 100/day
RESEND_API_KEY="your-resend-api-key"
# From address — must use a verified Resend domain (slvtechnical.com verified)
EMAIL_FROM="Tower Finder <no-reply@eurovape.com>"
# Dashboard template id or alias (leave empty to use inline HTML fallback)
RESEND_TEMPLATE_ID=

# Local dev only: print full OTP/reset codes in the server log. Off by default.
# DEV_EMAIL_LOG=1

# ---------------------------------------------------------------------------
# Build-time data (no env var)
#
# The ML scorer reads a public FCC antenna-structure dump from
# data/registry-cache/. It is git-ignored because it is ~60 MB and rebuildable.
# Without it every tower scores as unmeasured, so scoring silently degrades.
# Build it once on a new machine:
#
#   npx tsx scripts/fetch-registry-cache.ts
#   npx tsx scripts/import-registry-cache.ts --write
# ---------------------------------------------------------------------------
