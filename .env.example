# Database
PRISMA_DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
POSTGRES_URL="postgresql://user:password@localhost:5432/dbname"

# Authentication
NEXTAUTH_SECRET="your-nextauth-secret"
AUTH_SECRET="your-auth-secret"
MASTER_PASSWORD="admin-setup-password"

# External APIs
REPORTALL_API_KEY="your-reportall-key"
WHITEPAGES_API_KEY="your-whitepages-key"
GEOAPIFY_API_KEY="your-geoapify-key"
NUMVERIFY_API_KEY="your-numverify-key"

# Feature Flags
ENABLE_PARCEL_CACHE="false"

# Cron / Automation
CRON_SECRET="your-cron-secret"

# Resend — transactional email (OTP sign-in codes + future magic links)
# Free tier: 3,000 emails/mo, 100/day, one verified domain.
# Get a key at https://resend.com (put the real value in .env, not here)
RESEND_API_KEY="your-resend-api-key"
# Sender shown on OTP/magic-link emails. Until your domain is verified in
# Resend, the ONLY deliverable combo is the sandbox sender below, which
# reaches the email address your Resend account is registered with (e.g. a
# gmail address) — other recipients are rejected until the domain is verified.
EMAIL_FROM="Tower Finder <onboarding@resend.dev>"
# ── To send from your real domain instead (any recipient) ────────────────
# 1. Your hosting domain is https://tower-finder.vercel.app/, but *.vercel.app
#    cannot be used as a sender: Vercel owns that DNS zone, so Resend's
#    verification/DKIM TXT records can never be added there. Use your own
#    domain instead, e.g. towerfinder.com (register/buy it if not owned).
# 2. Resend dashboard -> Domains -> Add Domain -> enter your domain
#    (e.g. towerfinder.com). You will be shown two TXT records.
# 3. Add those TXT records at your DNS provider (registrar/host).
# 4. Click Verify in the Resend dashboard.
# 5. Then set: EMAIL_FROM="Tower Finder <no-reply@towerfinder.com>"
#    (and delete the sandbox line above).
#
# ── Optional: manage the sign-in-code email in the Resend Templates
#    dashboard instead of code ─────────────────────────────────────────────
# 1. resend.com/templates -> Create Template (name: "Sign-in Code").
#    Paste the HTML from signInCodeEmailHtml() in src/lib/email.ts,
#    replacing dynamic values with {{code}}, {{expiresInMinutes}},
#    {{expiryTime}}, {{year}} and setting the subject to
#    "Your Tower Finder sign-in code".
# 2. Copy the template id (tpl_…) or its alias into RESEND_TEMPLATE_ID
#    below, restart the dev server. The API then sends via the template
#    (payload `template: { id, variables }`) — the code keeps its inline
#    HTML fallback when this is empty.
RESEND_TEMPLATE_ID=
